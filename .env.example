# Backend service environment. Locally these are all optional — the defaults
# reproduce the previous file-based/localhost behaviour.

# Shared API key for both the dashboard API and the orchestrator. Locally,
# leaving this unset makes dashboard/api/auth.py generate and reuse
# secrets/dashboard_api_key.txt. In a deployment there is no persistent
# secrets/ directory, so set it explicitly and give the frontend the same value.
DASHBOARD_API_KEY=

# SQLite file location. Point this at a mounted volume in a deployment;
# a container filesystem is wiped on every redeploy.
DB_PATH=youtube_orchestration.db

# Where run.py and any other client looks for the Master Orchestrator.
ORCHESTRATOR_URL=http://localhost:8100

# Public port for the dashboard API (the platform injects this).
PORT=8000

# Internal-only port for the orchestrator, inside the same container.
ORCHESTRATOR_PORT=8100
