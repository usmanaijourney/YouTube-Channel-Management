{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-api",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "dashboard.api.app:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "set PATH=C:\\Program Files\\nodejs;%PATH% && cd frontend && npm run dev"],
      "port": 3000
    },
    {
      "name": "master-orchestrator",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "master_orchestrator.app:app", "--port", "8100"],
      "port": 8100
    }
  ]
}
